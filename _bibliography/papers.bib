@inproceedings{ram-etal-2026-validity,
  abbr = {AACL},
  title = {The Validity--Fidelity Gap: A Controlled Study of Representation Drift in Structured Extraction Under Redundant Contexts},
  author = {Seetha Ram, Gokul Srinath and Vasudevan, Anirudh and Elavazhagan, Rashmi},
  booktitle = {Findings of the Association for Computational Linguistics: IJCNLP-AACL 2026},
  month = nov,
  year = {2026},
  address = {Hengqin, China},
  publisher = {Association for Computational Linguistics},
  pages = {2112--2126},
  doi = {10.18653/2026.findings-aacl.107},
  url = {https://aclanthology.org/2026.findings-aacl.107/},
  html = {https://aclanthology.org/2026.findings-aacl.107/},
  pdf = {https://aclanthology.org/2026.findings-aacl.107.pdf},
  abstract = {Pipelines that use LLMs for structured extraction are commonly monitored by checking that each output parses as JSON and matches the expected keys. We show that this check can stay perfect while the extracted content degrades. We call the failure representation drift: the model still finds an entity but writes it in a different form than the intended one, for example a nested key-value object where a plain string is expected. We study this with synthetic clinical notes repeated 1x-32x. For LLaMA-3.1-8B-Instruct, micro-F1 falls from 0.499 to 0.259 while JSON validity stays 1.00. We introduce the Differential Redundancy Effect (DRE), the extra F1 drop under repeated content relative to a length-matched unrelated-filler control. The effect is large at 8B and near zero at 70B and Qwen2.5-72B. We also give a zero-ground-truth drift check and monitoring recommendations.},
  selected = {true}
}

